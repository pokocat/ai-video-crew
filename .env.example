# ──────────────────────────────────────────────────────────────────────────
# AI Video Crew — environment configuration
# ──────────────────────────────────────────────────────────────────────────

# Which generation backend the platform uses.
#   mock   → built-in simulated crew, runs offline, no API keys (default)
#   vimax  → delegate to a real ViMax (HKUDS/ViMax) worker over HTTP
GENERATION_PROVIDER=mock

# ── Real ViMax worker (only needed when GENERATION_PROVIDER=vimax) ──────────
# URL of the Python ViMax worker that exposes the pipeline over HTTP.
VIMAX_WORKER_URL=http://localhost:8000

# Credentials forwarded to ViMax. These mirror ViMax's own config keys
# (configs/idea2video.yaml / configs/agent.local.yaml).
VIMAX_LLM_API_KEY=
VIMAX_LLM_MODEL=google/gemini-2.5-flash-lite-preview-09-2025
VIMAX_IMAGE_API_KEY=
VIMAX_VIDEO_API_KEY=
